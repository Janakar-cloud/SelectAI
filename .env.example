# ═══════════════════════════════════════════════════════════
#  SelectAI — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://www.selectai.it.com

# ── MongoDB ───────────────────────────────────────────────
# Local MongoDB on the same EC2 server:
MONGODB_URI=mongodb://127.0.0.1:27017/selectai
# Or MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/selectai?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────
# Generate a strong random secret — e.g. run:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-64-chars
JWT_EXPIRES_IN=7d

# ── SMTP (for OTP & password reset emails) ────────────────
# Option A — Gmail (recommended for small volume):
#   1. Enable 2-Step Verification on your Gmail account
#   2. Go to myaccount.google.com → Security → App Passwords
#   3. Create an App Password for "Mail" and paste it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=SelectAI <noreply@selectai.it.com>

# Option B — SendGrid (for higher volume / production):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey

# ── Groq AI (for SelectAI Assistant chatbot) ──────────────
# Create a free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=SelectAI <noreply@selectai.it.com>

# Option C — AWS SES:
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-ses-smtp-access-key
# SMTP_PASS=your-ses-smtp-secret
# SMTP_FROM=SelectAI <noreply@selectai.it.com>
